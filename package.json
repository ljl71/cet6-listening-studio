{
  "name": "cet6-listening-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --open",
    "test": "node --test tests/*.test.mjs",
    "test:corpus": "node scripts/test-local-corpus.mjs",
    "collect": "node scripts/collect.mjs",
    "audit": "node scripts/audit-corpus.mjs",
    "verify:answers": "node scripts/reconcile-references.mjs",
    "align": "node scripts/align.mjs --model=tiny --apply",
    "check:release": "node scripts/audit-corpus.mjs --strict"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
